        "**/zz_generated*"
      ]
    },
    {
      "name": "etcd-docs",
      "kind": "git_repo",
      "description": "etcd documentation: operations, defrag, backup/restore, tuning",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/etcd-docs.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/etcd-io/website.git",
      "web_url": "https://gitlab.internal/mirrors/etcd-io/website",
