        "README.md"
      ]
    },
    {
      "name": "openshift-runbooks",
      "kind": "git_repo",
      "description": "OpenShift alert runbooks (alerts/**): what to do when an alert named in a runbook_url fires. Check the alert's own runbook first",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/openshift-runbooks.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/openshift/runbooks.git",
      "web_url": "https://gitlab.internal/mirrors/openshift/runbooks",
      "default_ref": "master",
      "docs": [
        "alerts/**/*.md"
      ]
    },
    {
      "name": "assisted-service",
