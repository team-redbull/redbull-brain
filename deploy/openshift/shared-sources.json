      "path": "${TEAM_KNOWLEDGE_SOURCES}/assisted-service.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/openshift/assisted-service.git",
      "web_url": "https://gitlab.internal/mirrors/openshift/assisted-service",
      "default_ref": "master",
      "docs": [
        "docs/**/*.md"
      ],
      "code_include": [
        "api/**",
        "internal/**"
      ],
      "code_exclude": [
        "vendor/**",
