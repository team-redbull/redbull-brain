{
  "cache_dir": "${TEAM_KNOWLEDGE_CACHE:-/data/cache}",
  "sources": [
    {
      "name": "brain",
      "kind": "git_repo",
      "description": "Team brain: our knowledge, runbooks, incident postmortems, inbox captures (main branch)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/team-brain.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/platform/team-brain.git",
      "web_url": "https://gitlab.internal/platform/team-brain",
      "default_ref": "main",
      "docs": [
        "knowledge/**/*.md",
        "runbooks/**/*.md",
        "incidents/**/*.md",
        "inbox/**/*.md",
        "mcp/servers/**/*.md"
      ],
      "code_include": [
        "knowledge/**",
        "runbooks/**",
        "incidents/**",
        "inbox/**"
      ]
    },
    {
      "name": "kubernetes-docs",
      "kind": "git_repo",
      "description": "Upstream Kubernetes documentation (pinned in team-brain docs/upstream/kubernetes, release 1.35 = newest fleet version; for older clusters verify version-specific behaviour)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/team-brain.git",
      "default_ref": "main",
      "docs": [
        "docs/upstream/kubernetes/**/*.md"
      ],
      "code_include": [
        "docs/upstream/kubernetes/**"
      ]
    },
    {
      "name": "rhokp",
      "kind": "rhokp_solr",
      "description": "Red Hat Offline Knowledge Portal: product docs (OCP, ACM/MCE, RHEL…), KCS solutions and articles, CVEs, errata",
      "url": "http://rhokp:8983",
      "core": "portal",
      "portal_url": "${RHOKP_URL:-https://rhokp-team-knowledge.apps.mgmt.internal}",
      "default_product": ""
    },
    {
      "name": "argocd-docs",
      "kind": "mkdocs_site",
      "description": "Argo CD documentation (internal mirror)",
      "url": "${ARGOCD_DOCS_URL:-https://docs-mirror.internal/argo-cd/stable}",
      "ca_file": "${INTERNAL_CA_FILE:-}",
      "refresh_hours": 24
    },
    {
      "name": "hypershift",
      "kind": "git_repo",
      "description": "openshift/hypershift: HostedCluster/NodePool APIs, operators, docs (docs/content)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/hypershift.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/openshift/hypershift.git",
      "web_url": "https://gitlab.internal/mirrors/openshift/hypershift",
      "default_ref": "main",
      "docs": [
        "docs/content/**/*.md"
      ],
      "code_include": [
        "api/**",
        "hypershift-operator/**",
        "control-plane-operator/**",
        "control-plane-pki-operator/**",
        "ignition-server/**",
        "cmd/**",
        "support/**",
        "product-cli/**"
      ],
      "code_exclude": [
        "vendor/**",
        "**/zz_generated*",
        "**/*_test.go"
      ]
    },
    {
      "name": "cluster-api",
      "kind": "git_repo",
      "description": "kubernetes-sigs/cluster-api: Cluster/Machine/MachineSet/MHC APIs and controllers, the CAPI book",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/cluster-api.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kubernetes-sigs/cluster-api.git",
      "web_url": "https://gitlab.internal/mirrors/kubernetes-sigs/cluster-api",
      "default_ref": "main",
      "docs": [
        "docs/book/src/**/*.md",
        "docs/proposals/**/*.md"
      ],
      "code_include": [
        "api/**",
        "internal/**",
        "controllers/**",
        "exp/**",
        "util/**",
        "cmd/**",
        "bootstrap/**",
        "controlplane/**",
        "feature/**"
      ],
      "code_exclude": [
        "**/zz_generated*",
        "**/*_test.go"
      ]
    },
    {
      "name": "cluster-api-provider-agent",
      "kind": "git_repo",
      "description": "openshift/cluster-api-provider-agent — CAPI provider HyperShift uses for Agent-platform NodePools",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/cluster-api-provider-agent.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/openshift/cluster-api-provider-agent.git",
      "web_url": "https://gitlab.internal/mirrors/openshift/cluster-api-provider-agent",
      "default_ref": "master",
      "docs": [
        "docs/**/*.md",
        "README.md"
      ],
      "code_include": [
        "api/**",
        "controllers/**"
      ]
    },
    {
      "name": "cluster-api-provider-metal3",
      "kind": "git_repo",
      "description": "metal3-io/cluster-api-provider-metal3 — Metal3Machine/Metal3Cluster, BMH association",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/cluster-api-provider-metal3.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/metal3-io/cluster-api-provider-metal3.git",
      "web_url": "https://gitlab.internal/mirrors/metal3-io/cluster-api-provider-metal3",
      "default_ref": "main",
      "docs": [
        "docs/**/*.md"
      ],
      "code_include": [
        "api/**",
        "baremetal/**",
        "controllers/**"
      ]
    },
    {
      "name": "baremetal-operator",
      "kind": "git_repo",
      "description": "metal3-io/baremetal-operator — BareMetalHost state machine, Ironic provisioner, BMC drivers",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/baremetal-operator.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/metal3-io/baremetal-operator.git",
      "web_url": "https://gitlab.internal/mirrors/metal3-io/baremetal-operator",
      "default_ref": "main",
      "docs": [
        "docs/**/*.md"
      ],
      "code_include": [
        "apis/**",
        "pkg/**",
        "internal/**",
        "cmd/**"
      ]
    },
    {
      "name": "ako",
      "kind": "git_repo",
      "description": "AKO (Avi Kubernetes Operator): our load balancer/ingress. Docs + CRDs/code. Use the tag matching the AKO version installed on the cluster",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/ako.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/vmware/load-balancer-and-ingress-services-for-kubernetes.git",
      "web_url": "https://gitlab.internal/mirrors/vmware/load-balancer-and-ingress-services-for-kubernetes",
      "default_ref": "master",
      "docs": [
        "docs/**/*.md",
        "README.md"
      ],
      "code_include": [
        "pkg/**",
        "internal/**",
        "cmd/**",
        "helm/**"
      ],
      "code_exclude": [
        "vendor/**",
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "envoy",
      "kind": "git_repo",
      "description": "Envoy proxy docs (docs/root, reST). Docs only; use the release-1.NN branch matching the Envoy version in use (OSSM/Gateway/KServe)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/envoy.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/envoyproxy/envoy.git",
      "web_url": "https://gitlab.internal/mirrors/envoyproxy/envoy",
      "default_ref": "main",
      "docs": [
        "docs/root/**/*.rst",
        "docs/root/**/*.md"
      ]
    },
    {
      "name": "envoy-gateway",
      "kind": "git_repo",
      "description": "Envoy Gateway docs and API types (Gateway API implementation)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/envoy-gateway.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/envoyproxy/gateway.git",
      "web_url": "https://gitlab.internal/mirrors/envoyproxy/gateway",
      "default_ref": "main",
      "docs": [
        "site/content/en/latest/**/*.md",
        "docs/**/*.md"
      ],
      "code_include": [
        "api/**",
        "internal/**"
      ],
      "code_exclude": [
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "kserve",
      "kind": "git_repo",
      "description": "KServe source: InferenceService/ServingRuntime APIs and controllers. Use the tag matching KServe in RHOAI/ODH on the cluster",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/kserve.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kserve/kserve.git",
      "web_url": "https://gitlab.internal/mirrors/kserve/kserve",
      "default_ref": "master",
      "docs": [
        "docs/**/*.md",
        "README.md"
      ],
      "code_include": [
        "pkg/apis/**",
        "pkg/controller/**",
        "pkg/webhook/**",
        "cmd/**",
        "config/**"
      ],
      "code_exclude": [
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "kserve-website",
      "kind": "git_repo",
      "description": "KServe documentation website content",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/kserve-website.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kserve/website.git",
      "web_url": "https://gitlab.internal/mirrors/kserve/website",
      "default_ref": "main",
      "docs": [
        "docs/**/*.md"
      ]
    },
    {
      "name": "prometheus-docs",
      "kind": "git_repo",
      "description": "Prometheus documentation: PromQL, configuration, alerting, storage",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/prometheus-docs.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/prometheus/docs.git",
      "web_url": "https://gitlab.internal/mirrors/prometheus/docs",
      "default_ref": "main",
      "docs": [
        "docs/**/*.md"
      ]
    },
    {
      "name": "prometheus-operator",
      "kind": "git_repo",
      "description": "prometheus-operator docs and CRD types (ServiceMonitor, PrometheusRule, Alertmanager). OCP ships its own build; use the tag matching the cluster",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/prometheus-operator.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/prometheus-operator/prometheus-operator.git",
      "web_url": "https://gitlab.internal/mirrors/prometheus-operator/prometheus-operator",
      "default_ref": "main",
      "docs": [
        "Documentation/**/*.md",
        "README.md"
      ],
      "code_include": [
        "pkg/apis/**"
      ],
      "code_exclude": [
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "grafana-docs",
      "kind": "git_repo",
      "description": "Grafana documentation (docs/sources): datasources, dashboards, alerting, provisioning. Docs only (large repo)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/grafana-docs.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/grafana/grafana.git",
      "web_url": "https://gitlab.internal/mirrors/grafana/grafana",
      "default_ref": "main",
      "docs": [
        "docs/sources/**/*.md"
      ]
    },
    {
      "name": "mcp-grafana",
      "kind": "git_repo",
      "description": "Grafana MCP server source: tools (list_datasources, query_prometheus…), flags, env vars",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/mcp-grafana.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/grafana/mcp-grafana.git",
      "web_url": "https://gitlab.internal/mirrors/grafana/mcp-grafana",
      "default_ref": "main",
      "docs": [
        "README.md",
        "docs/**/*.md"
      ],
      "code_include": [
        "*.go",
        "tools/**",
        "cmd/**"
      ],
      "code_exclude": [
        "**/*_test.go"
      ]
    },
    {
      "name": "portworx-docs",
      "kind": "markdown_dir",
      "enabled": false,
      "description": "Portworx documentation. No public source repo exists (portworx/px-docs is an archived 2018 snapshot; the docs.portworx.com source is private). Enable by pointing PORTWORX_DOCS_DIR at an internal export/mirror of the docs for the version we run",
      "root": "${PORTWORX_DOCS_DIR:-/data/portworx-docs}",
      "include": [
        "**/*.md",
        "**/*.html"
      ]
    },
    {
      "name": "vllm",
      "kind": "git_repo",
      "description": "vLLM docs and engine source (flags, serving, quantization, distributed). Use the tag of the vLLM image in use",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/vllm.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/vllm-project/vllm.git",
      "web_url": "https://gitlab.internal/mirrors/vllm-project/vllm",
      "default_ref": "main",
      "docs": [
        "docs/**/*.md"
      ],
      "code_include": [
        "vllm/**"
      ],
      "code_exclude": [
        "**/tests/**",
        "**/*_test.py",
        "**/test_*.py"
      ]
    },
    {
      "name": "lws",
      "kind": "git_repo",
      "description": "LeaderWorkerSet (LWS): multi-node inference workloads. Docs + API + controllers",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/lws.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kubernetes-sigs/lws.git",
      "web_url": "https://gitlab.internal/mirrors/kubernetes-sigs/lws",
      "default_ref": "main",
      "docs": [
        "site/content/en/docs/**/*.md",
        "docs/**/*.md",
        "README.md"
      ],
      "code_include": [
        "api/**",
        "pkg/**",
        "cmd/**"
      ],
      "code_exclude": [
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "metal3-docs",
      "kind": "git_repo",
      "description": "Metal3 user guide and design docs (BareMetalHost, provisioning, Ironic)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/metal3-docs.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/metal3-io/metal3-docs.git",
      "web_url": "https://gitlab.internal/mirrors/metal3-io/metal3-docs",
      "default_ref": "main",
      "docs": [
        "docs/**/*.md",
        "design/**/*.md"
      ]
    },
    {
      "name": "ironic",
      "kind": "git_repo",
      "description": "OpenStack Ironic docs (BMC drivers, provisioning states, deploy steps). Docs only",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/ironic.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/openstack/ironic.git",
      "web_url": "https://gitlab.internal/mirrors/openstack/ironic",
      "default_ref": "master",
      "docs": [
        "doc/source/**/*.rst"
      ]
    },
    {
      "name": "gateway-api",
      "kind": "git_repo",
      "description": "Gateway API docs + types (Gateway, HTTPRoute…). Use the v1.x tag matching the installed CRDs",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/gateway-api.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kubernetes-sigs/gateway-api.git",
      "web_url": "https://gitlab.internal/mirrors/kubernetes-sigs/gateway-api",
      "default_ref": "main",
      "docs": [
        "site/content/**/*.md",
        "geps/**/*.md"
      ],
      "code_include": [
        "apis/**"
      ],
      "code_exclude": [
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "gpu-operator",
      "kind": "git_repo",
      "description": "NVIDIA GPU Operator: ClusterPolicy, driver/toolkit/DCGM/MIG handling. Use the tag matching the installed operator",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/gpu-operator.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/NVIDIA/gpu-operator.git",
      "web_url": "https://gitlab.internal/mirrors/NVIDIA/gpu-operator",
      "default_ref": "main",
      "docs": [
        "README.md",
        "docs/**/*.md"
      ],
      "code_include": [
        "api/**",
        "controllers/**",
        "internal/**",
        "assets/**"
      ],
      "code_exclude": [
        "vendor/**",
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "node-feature-discovery",
      "kind": "git_repo",
      "description": "Node Feature Discovery docs and API (NodeFeatureRule, labels used for GPU scheduling)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/node-feature-discovery.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kubernetes-sigs/node-feature-discovery.git",
      "web_url": "https://gitlab.internal/mirrors/kubernetes-sigs/node-feature-discovery",
      "default_ref": "master",
      "docs": [
        "docs/**/*.md"
      ],
      "code_include": [
        "api/**",
        "pkg/**"
      ],
      "code_exclude": [
        "vendor/**",
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "kueue",
      "kind": "git_repo",
      "description": "Kueue docs and API (job queueing, quotas; pairs with LWS/GPU workloads)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/kueue.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/kubernetes-sigs/kueue.git",
      "web_url": "https://gitlab.internal/mirrors/kubernetes-sigs/kueue",
      "default_ref": "main",
      "docs": [
        "site/content/en/docs/**/*.md"
      ],
      "code_include": [
        "apis/**",
        "pkg/**"
      ],
      "code_exclude": [
        "**/*_test.go",
        "**/zz_generated*"
      ]
    },
    {
      "name": "ovn-kubernetes",
      "kind": "git_repo",
      "description": "OVN-Kubernetes docs (OCP default CNI): features, UDN, egress, troubleshooting",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/ovn-kubernetes.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/ovn-org/ovn-kubernetes.git",
      "web_url": "https://gitlab.internal/mirrors/ovn-org/ovn-kubernetes",
      "default_ref": "master",
      "docs": [
        "docs/**/*.md"
      ]
    },
    {
      "name": "multus-cni",
      "kind": "git_repo",
      "description": "Multus CNI docs (secondary networks, NetworkAttachmentDefinition)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/multus-cni.git",
      "remote": "${GIT_MIRROR_BASE:-https://gitlab.internal}/mirrors/k8snetworkplumbingwg/multus-cni.git",
      "web_url": "https://gitlab.internal/mirrors/k8snetworkplumbingwg/multus-cni",
      "default_ref": "master",
      "docs": [
