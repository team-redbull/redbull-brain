      ]
    },
    {
      "name": "gitops-day1-platform-config",
      "kind": "git_repo",
      "enabled": false,
      "description": "Team repo: day1 platform-config (hosted-cluster values, mastertag versions, DHCP values). Internal GitLab project — set the real remote; searchable with search_code (e.g. pattern mastertag)",
      "path": "${TEAM_KNOWLEDGE_SOURCES}/gitops-day1-platform-config.git",
      "remote": "${GITOPS_DAY1_REMOTE:-https://gitlab.internal/gitops-day1/platform-config.git}",
      "default_ref": "main",
      "docs": [
        "README.md"
      ],
      "code_include": [
